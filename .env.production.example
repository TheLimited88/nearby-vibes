# Production Environment Configuration
# Copy to .env.production and fill in actual values

# Database
DATABASE_URL=postgresql://user:password@db.prod.digitalocean.com:25060/nearby_vibes?sslmode=require

# JWT
JWT_SECRET=your-production-jwt-secret-min-32-chars

# Firebase
FIREBASE_PROJECT_ID=nearby-vibes-prod
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@nearby-vibes-prod.iam.gserviceaccount.com

# Paddle (Payment Processing)
PADDLE_API_KEY=your-paddle-api-key
PADDLE_WEBHOOK_SECRET=your-paddle-webhook-secret
PADDLE_ENVIRONMENT=production

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_TURNSTILE_SECRET=your-turnstile-secret-key

# Admin Portal
ADMIN_PORTAL_PATH=/admin-your-random-secret-path
ADMIN_PORTAL_SECRET=your-admin-portal-secret-token

# Monitoring & Logging
SENTRY_DSN=your-sentry-dsn
DATADOG_API_KEY=your-datadog-api-key
LOG_LEVEL=info
NODE_ENV=production

# API Configuration
API_BASE_URL=https://api.nearby-vibes.com
API_PORT=3001
FRONTEND_URL=https://nearby-vibes.com
ENABLE_RATE_LIMITING=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email & Notifications
SENDGRID_API_KEY=your-sendgrid-api-key
FCM_PROJECT_ID=your-fcm-project-id
FCM_SERVICE_ACCOUNT_KEY=your-fcm-service-account-key

# Security
CORS_ORIGINS=https://nearby-vibes.com,https://admin.nearby-vibes.com
HTTPS_ONLY=true
SECURE_COOKIES=true

# Abuse Prevention
VPN_CHECK_ENABLED=true
MAXMIND_ACCOUNT_ID=your-maxmind-account-id
MAXMIND_LICENSE_KEY=your-maxmind-license-key
DISPOSABLE_EMAIL_CHECK_ENABLED=true

# Performance
DATABASE_POOL_MIN=10
DATABASE_POOL_MAX=20
REDIS_URL=redis://cache.prod.internal:6379

# Feature Flags
TRIAL_DURATION_DAYS=14
GRACE_PERIOD_DAYS=3
COOLDOWN_DAYS=90
FOUNDING_VENUE_PROGRAM_ENABLED=true
